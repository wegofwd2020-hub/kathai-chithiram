        <mxCell id="pe10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82B366;endArrow=block;" edge="1" parent="1" source="c2b" target="c3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82B366;endArrow=block;" edge="1" parent="1" source="c3b" target="c4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- corpus retrieval feeds the Ground step of track 1 -->
        <mxCell id="pe12" value="grounds" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82B366;endArrow=block;dashed=1;" edge="1" parent="1" source="c4b" target="s5b"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- clinician unblocks -->
        <mxCell id="pe13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D79B00;endArrow=block;dashed=1;" edge="1" parent="1" source="gg1" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- corpus enables surface 2 -->
        <mxCell id="pe14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#999999;endArrow=block;dashed=1;" edge="1" parent="1" source="c4b" target="qq1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
